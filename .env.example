# Copy this file to .env and fill in your values.
# .env is only used locally. On Render, set these in the dashboard.

SECRET_KEY=change-me-to-a-long-random-string

# ── Gmail SMTP ───────────────────────────────────────────────────────────────
# Use a Gmail App Password, NOT your regular Gmail password.
# How to generate one:
#   1. Enable 2-Step Verification on your Google account.
#   2. Go to myaccount.google.com → Security → App passwords.
#   3. Generate a password for "Mail" → copy the 16-character code.
SMTP_SENDER_EMAIL=your-ngo@gmail.com
SMTP_SENDER_NAME=HealthBridge NGO
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_PASSWORD=your-sixteen-char-app-password

# ── Database (leave blank for local SQLite) ───────────────────────────────────
# DATABASE_URL=
