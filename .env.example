# Copy this file to .env and fill in your values.
# .env is only used locally. On Render/Railway, set these in the dashboard.

SECRET_KEY=change-me-to-a-long-random-string

# ── Resend email delivery ─────────────────────────────────────────────────────
# Sign up at resend.com (free tier: 3,000 emails/month, 100/day)
#
# Step 1: Add and verify your sending domain at resend.com → Domains
# Step 2: Create an API key at resend.com → API Keys
# Step 3: Fill in the values below

RESEND_API_KEY=re_Ghz5rM2f_GtTN9Z8pbA2AZu3qMGnxfgqY
# Must be an address at your verified Resend domain, e.g. hello@yourdomain.com
# Resend free tier also allows: onboarding@resend.dev (for testing only)
RESEND_SENDER_EMAIL=onboarding@resend.dev
RESEND_SENDER_NAME=HealthBridge NGO

# ── Database (leave blank for local SQLite) ───────────────────────────────────
